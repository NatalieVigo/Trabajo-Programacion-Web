# Copia este archivo como .env para configurar tu entorno local (.env no se sube al repositorio).

# Puerto de la API; el frontend la busca en http://localhost:3000/api
PORT=3000
# Origen del frontend que puede llamar a la API (CORS)
CORS_ORIGIN=http://localhost:5173

# MySQL de XAMPP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mesa_ayuda

# Clave para firmar los tokens de sesión: pon una frase larga y secreta
JWT_SECRET=cambia-esta-clave-por-una-larga-y-secreta

# No se envían correos reales (enunciado §4): con true la API devuelve el enlace de recuperación para la bandeja simulada
CORREOS_SIMULADOS=true
